#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# write_link_outputs — Reads the permissions module's Terraform outputs and
# writes them to the NP link attributes.
#
# "export": true fields (username, database_name) become plain env vars.
# "export": {secret: true} fields (password, connection_string) are stored
# encrypted — they read back as null through the API, which is expected — and
# injected into the application at runtime.
# ---------------------------------------------------------------------------

if [ "${LINK_NEVER_CREATED:-false}" = "true" ]; then
  echo "LINK_NEVER_CREATED=true — no outputs to write."
  exit 0
fi

cd "$OUTPUT_DIR"

LINK_ID_VAL=$(echo "$CONTEXT" | jq -r '.link.id')

echo "Reading Terraform outputs for link $LINK_ID_VAL..."

USERNAME=$(tofu output -raw username 2>/dev/null || echo "")
PASSWORD=$(tofu output -raw password 2>/dev/null || echo "")
DATABASE_NAME=$(tofu output -raw database_name 2>/dev/null || echo "")
CONNECTION_STRING=$(tofu output -raw connection_string 2>/dev/null || echo "")

if [ -z "$USERNAME" ]; then
  echo "WARNING: No username output found. Skipping link attribute update."
  exit 0
fi

ATTRS=$(jq -n \
  --arg username          "$USERNAME" \
  --arg password          "$PASSWORD" \
  --arg database_name     "$DATABASE_NAME" \
  --arg connection_string "$CONNECTION_STRING" \
  '{
    username:          $username,
    password:          $password,
    database_name:     $database_name,
    connection_string: $connection_string
  }')

echo "Updating link $LINK_ID_VAL attributes:"
echo "  username:          $USERNAME"
echo "  database_name:     $DATABASE_NAME"
echo "  password:          ****"
echo "  connection_string: ****"

np link patch --id "$LINK_ID_VAL" --body "{\"attributes\": $ATTRS}"
echo "Link attributes updated successfully."
