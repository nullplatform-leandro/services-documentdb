#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# build_permissions_context — Prepares the Terraform execution environment for
# link actions (link / link-update / unlink). Runs AFTER build_context.
#
# The difference from the cluster service: the database is NOT a link input.
# It is the one this service owns, so the link only chooses an access level.
# ---------------------------------------------------------------------------

# Shell functions do NOT carry across scripts — each runs in its own process.
yaml_value() {
  local key="$1" default="$2" file="$3"
  local val
  val=$(grep "^${key}:" "$file" 2>/dev/null | sed 's/^[^:]*: *//;s/^"//;s/"$//' | head -1)
  echo "${val:-$default}"
}

if [ -z "${REGION:-}" ]; then
  echo "ERROR: REGION is not set. Expected to be exported by build_context." >&2
  exit 1
fi

if [ -z "${TFSTATE_BUCKET:-}" ]; then
  echo "ERROR: TFSTATE_BUCKET is not set. Expected to be exported by build_context." >&2
  exit 1
fi

AWS_PROFILE_VAL=$(yaml_value "aws_profile" "" "$VALUES")

if [ -n "${AWS_PROFILE_VAL}" ] && [ -z "${AWS_PROFILE:-}" ]; then
  export AWS_PROFILE="${AWS_PROFILE_VAL}"
fi

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')
ACTION_TYPE=$(echo "$CONTEXT" | jq -r '.type // ""')
SERVICE_ATTRS=$(echo "$CONTEXT" | jq -r '.service.attributes // {}')

# Prefer the values build_context resolved this run; fall back to what the
# service recorded on create. On an unlink both may be present and agree.
DOCDB_HOST="${DOCDB_HOST:-$(echo "$SERVICE_ATTRS" | jq -r '.endpoint // ""')}"
DOCDB_PORT="${DOCDB_PORT:-$(echo "$SERVICE_ATTRS" | jq -r '.port // 27017')}"
MASTER_SECRET_ARN="${MASTER_SECRET_ARN:-$(echo "$SERVICE_ATTRS" | jq -r '.master_secret_arn // ""')}"
DB_NAME="${DB_NAME:-$(echo "$SERVICE_ATTRS" | jq -r '.database_name // ""')}"

# --- Tolerate links whose service never finished being created --------------
# Unlinking after a failed create is a normal operation, not an error: the
# platform still has to be able to clean the entity up.

link_never_created() {
  echo "$1"
  echo "LINK_NEVER_CREATED=true — skipping tofu."
  export LINK_NEVER_CREATED=true
  export OUTPUT_DIR="/tmp/np-link-${LINK_ID:-unknown}"
  mkdir -p "$OUTPUT_DIR"
  exit 0
}

if [ -z "$DOCDB_HOST" ] || [ -z "$MASTER_SECRET_ARN" ] || [ -z "$DB_NAME" ]; then
  if [ "$ACTION_TYPE" = "delete" ]; then
    link_never_created "WARNING: unlink with no resolved cluster/database on the service."
  fi
  echo "ERROR: endpoint, master_secret_arn or database_name missing from service attributes." >&2
  echo "       Has the database been created and write_service_outputs completed?" >&2
  exit 1
fi

# --- Derive the MongoDB username from the link ID --------------------------
# Deterministic, so the destroy path can find the user it has to drop.

MONGO_USERNAME="np_$(echo "${LINK_ID}" | tr -d '-' | cut -c1-16 | tr '[:upper:]' '[:lower:]')"

export OUTPUT_DIR="/tmp/np-link-${LINK_ID}"
mkdir -p "$OUTPUT_DIR"

export TOFU_MODULE_DIR="$SERVICE_PATH/permissions"

export TOFU_INIT_VARIABLES="-backend-config=bucket=${TFSTATE_BUCKET} -backend-config=key=services/documentdb-database/${SERVICE_ID}/links/${LINK_ID}.tfstate -backend-config=region=${REGION} -backend-config=use_lockfile=true"

export TOFU_VARIABLES="-var=link_id=${LINK_ID} -var=region=${REGION} -var=docdb_host=${DOCDB_HOST} -var=docdb_port=${DOCDB_PORT} -var=db_name=${DB_NAME} -var=mongo_username=${MONGO_USERNAME} -var=master_secret_arn=${MASTER_SECRET_ARN} -var=access_level=${LINK_ACCESS_LEVEL:-read-write}"
